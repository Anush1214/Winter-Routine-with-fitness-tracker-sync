# ❄️ WINTER ARC 2026 - ENVIRONMENT CONFIGURATION

# 1. Supabase PostgreSQL Database Connection
# Transaction pooling connection string (port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string for Prisma migrations & push (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Push Notifications (ntfy.sh - Zero Apple/Google Developer Fees)
# Topic name: e.g. "winter-arc-yourname"
NTFY_TOPIC="winter-arc-routine"
NTFY_SERVER="https://ntfy.sh"

# 3. Scheduled Automation Security (GitHub Actions Cron)
# Secret token to protect /api/notifications/trigger
CRON_SECRET="winter_arc_super_secret_token_2026"

# 4. App Deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
